ing-left: 14px}\n\n      .side-nav ol {gap: 14px}\n\n      .side-nav a {font-size: 12px}\n\n      .hero {padding: 48px 0 68px}\n\n      h1 {font-size: clamp(48px, 16vw, 72px)}\n\n      .timeline-item {grid-template-columns: 58px 1fr;gap: 12px}\n\n      section {padding: 72px 0}\n\n      .plan-grid,\n      .faq-row {grid-template-columns: 1fr}\n\n      .plan-card {min-height: auto}\n\n      .faq-answer {margin-left: 14px}\n\n      .closing-inner {padding: 28px 22px}\n\n      .footer-inner {flex-direction: column}\n    }\n  </style><div class=\"side-nav\">\n    <a class=\"brand-mini\" href=\"#top\">已跑路<span>(AAEX)</span></a>\n    <nav aria-label=\"页面目录\">\n      <ol>\n        <li><a href=\"#overview\">先看这里</a></li>\n        <li><a href=\"#plans\">套餐怎么选</a></li>\n        <li><a href=\"#guide\">使用说明</a></li>\n        <li><a href=\"#clients\">客户端</a></li>\n        <li><a href=\"#faq\">常见问题</a></li>\n      </ol>\n    </nav>\n    <p class=\"side-note\">信息整理型页面<br>套餐与客户端状态请以实际提供信息为准</p>\n  </div>\n\n  <main id=\"top\">\n    <div class=\"hero\">\n      <div class=\"shell\">\n        <p class=\"eyebrow\">AAEX · 使用前信息导航</p>\n        <h1>已跑路(AAEX) · 先看懂，<em>再出发。</em></h1>\n        <p class=\"hero-lead\">关于已跑路(AAEX)，我们把套餐选择、客户端准备和首次连接拆成几个清晰步骤。你可以先读说明，再根据实际需求决定，不必在信息还不清楚时仓促操作。</p>\n        <div class=\"hero-actions\">\n          <a class=\"button\" href=\"#plans\">查看套餐结构</a>\n          <a class=\"button secondary\" href=\"#guide\">阅读使用说明</a>\n        </div>\n\n        <div class=\"timeline\" aria-label=\"阅读路径\">\n          <div class=\"timeline-item\">\n            <time>STEP 01</time>\n            <p>确认用途：了解个人使用、多设备连接或多人共享等不同需求，再选择相应套餐。</p>\n          </div>\n          <div class=\"timeline-item\">\n            <time>STEP 02</time>\n            <p>核对套餐：当前页面仅展示套餐分类，价格、流量、线路与设备数量需以实际购买页说明为准。</p>\n          </div>\n          <div class=\"timeline-item\">\n            <time>STEP 03</time>\n            <p>准备客户端：根据设备系统选择兼容工具，导入信息后再进行首次连接。</p>\n          </div>\n          <div class=\"timeline-item\">\n            <time>STEP 04</time>\n            <p>检查连接：完成基础设置后逐项验证，如遇问题可先从下方常见问题中排查。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <section id=\"overview\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <span class=\"section-index\">01 / OVERVIEW</span>\n            <h2>先把边界说清楚。</h2>\n          </div>\n          <p class=\"section-intro\">页面没有提供可用于核验的运营信息、套餐价格或客户端下载地址，因此这里不虚构交易入口与下载链接。下方内容主要用于帮助你理解选择逻辑、使用流程以及购买前应该确认的事项。</p>\n        </div>\n\n        <div class=\"info-board\">\n          <article class=\"info-box dark\">\n            <h3>适合先确认的问题</h3>\n            <ul>\n              <li>套餐是否覆盖你的常用设备与使用人数？</li>\n              <li>价格、流量周期和续费方式是否写清楚？</li>\n              <li>服务支持、退款规则与有效期如何说明？</li>\n              <li>客户端由哪里提供，配置如何导入？</li>\n            </ul>\n          </article>\n          <article class=\"info-box\">\n            <h3>当前页面能提供什么</h3>\n            <ul>\n              <li>按基础、旗舰、团队三类理解套餐差异。</li>\n              <li>了解常见客户端类型与各自适用系统。</li>\n              <li>掌握从选择套餐到检查连接的通用步骤。</li>\n              <li>提前了解续费、配置迁移与售后确认方式。</li>\n            </ul>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"plans\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <span class=\"section-index\">02 / PLANS</span>\n            <h2>三类套餐，按需求看。</h2>\n          </div>\n          <p class=\"section-intro\">下面保留套餐定位，方便比较使用方向。具体价格、流量额度、设备上限、线路类型与附加权益均未获得可靠资料支持，请勿将未展示的信息视为承诺。</p>\n        </div>\n\n        <div class=\"plan-grid\">\n          <article class=\"plan-card\">\n            <span class=\"plan-number\">PLAN / 01</span>\n            <h3>基础版</h3>\n            <p class=\"plan-price\">价格待确认</p>\n            <ul class=\"plan-list\">\n              <li>适合先了解基础连接需求的用户</li>\n              <li>关注常规流量与个人使用范围</li>\n              <li>购买前核对计费周期与设备数量</li>\n            </ul>\n          </article>\n\n          <article class=\"plan-card featured\">\n            <span class=\"plan-tag\">更多功能关注</span>\n            <span class=\"plan-number\">PLAN / 02</span>\n            <h3>旗舰版</h3>\n            <p class=\"plan-price\">价格待确认 <small>以实际购买页为准</small></p>\n            <ul class=\"plan-list\">\n              <li>适合对使用范围有进阶要求的个人</li>\n              <li>重点核对多设备与线路说明</li>\n              <li>确认服务支持方式及具体权益</li>\n            </ul>\n          </article>\n\n          <article class=\"plan-card\">\n            <span class=\"plan-number\">PLAN / 03</span>\n            <h3>团队版</h3>\n            <p class=\"plan-price\">价格待确认</p>\n            <ul class=\"plan-list\">\n              <li>适合多人或多设备协同使用场景</li>\n              <li>关注人数、带宽与配置管理要求</li>\n              <li>购买前确认定制范围与服务边界</li>\n            </ul>\n          </article>\n\n          <article class=\"plan-card\">\n            <span class=\"plan-number\">PLAN / 04</span>\n            <h3>怎么选，不绕弯</h3>\n            <ul class=\"plan-list\">\n              <li>先用设备数量和使用人数判断需求。</li>\n              <li>再看流量、线路与支持方式是否匹配。</li>\n              <li>最后核对周期、到期与续费规则。</li>\n              <li>信息不一致时，先暂停购买并询问服务方。</li>\n            </ul>\n          </article>\n        </div>\n        <p class=\"plan-note\">说明：页面未提供可核验价格，因此不展示虚构金额，也不设置购买按钮。</p>\n      </div>\n    </section>\n\n    <section id=\"guide\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <span class=\"section-index\">03 / GUIDE</span>\n            <h2>第一次使用，<br>照着做就行。</h2>\n          </div>\n          <p class=\"section-intro\">不同客户端的操作细节可能不同，但整体路径基本一致。不要从不明来源下载工具，也不要把配置链接或订阅信息随意转发给无关人员。</p>\n        </div>\n\n        <div class=\"info-board\">\n          <article class=\"info-box\">\n            <h3>通用连接步骤</h3>\n            <ol class=\"steps\">\n              <li><strong>确认套餐。</strong>根据设备数量与使用场景选择类别，并记录服务方明确提供的周期和权益。</li>\n              <li><strong>准备客户端。</strong>从服务方提供的来源下载与设备系统匹配的版本，并核对发布方信息。</li>\n              <li><strong>导入配置。</strong>按照说明添加订阅或配置文件，避免复制到损坏、缺行的内容。</li>\n              <li><strong>更新并选择。</strong>更新可用配置，按实际需要选择节点，再启动连接。</li>\n              <li><strong>逐项检查。</strong>确认客户端状态、目标应用与延迟表现，发现异常时先切换配置再排查。</li>\n            </ol>\n          </article>\n\n          <article class=\"info-box dark\">\n            <h3>使用中的好习惯</h3>\n            <ul>\n              <li>订阅信息等同于访问凭证，不公开截图或转发。</li>\n              <li>只保留当前需要的客户端与配置版本。</li>\n              <li>更换设备时先迁移配置，再清理旧设备记录。</li>\n              <li>续费前再次核对套餐名称、周期与实际价格。</li>\n              <li>保存服务方提供的说明，避免到期后无从确认权益。</li>\n            </ul>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"clients\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <span class=\"section-index\">04 / CLIENTS</span>\n            <h2>先看设备，再选客户端。</h2>\n          </div>\n          <p class=\"section-intro\">当前没有已确认的客户端品牌、版本与下载地址，因此本页不放置第三方安装包。你可以按设备类别理解需求，再向服务方索取对应说明。</p>\n        </div>\n\n        <div class=\"client-grid\">\n          <article class=\"client-card\">\n            <span class=\"client-type\">DESKTOP</span>\n            <h3>桌面客户端</h3>\n            <p>适用于 Windows、macOS 或 Linux 设备。下载前先确认系统版本、处理器架构以及服务方提供的客户端名称。</p>\n            <span class=\"status\">等待确认具体下载来源</span>\n          </article>\n\n          <article class=\"client-card\">\n            <span class=\"client-type\">MOBILE</span>\n            <h3>移动端客户端</h3>\n            <p>适用于 Android 与 iOS 设备。系统权限、应用商店来源和配置导入方式可能不同，应以实际客户端说明为准。</p>\n            <span class=\"status\">等待确认平台版本</span>\n          </article>\n\n          <article class=\"client-card\">\n            <span class=\"client-type\">MULTI-DEVICE</span>\n            <h3>多设备使用</h3>\n            <p>连接设备前先核对套餐允许的设备数量、是否共享订阅，以及后台管理与配置同步是否包含在所选权益中。</p>\n            <span class=\"status\">等待确认设备上限</span>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section id=\"faq\">\n      <div class=\"shell\">\n        <div class=\"section-head\">\n          <div>\n            <span class=\"section-index\">05 / FAQ</span>\n            <h2>常见问题，直接说重点。</h2>\n          </div>\n          <p class=\"section-intro\">如果你没有看到明确答案，不要凭猜测操作。先确认原始说明，再按实际情况处理。</p>\n        </div>\n\n        <div class=\"faq-list\">\n          <article class=\"faq-row\">\n            <div class=\"faq-question\">已跑路(AAEX)的套餐价格是多少？</div>\n            <div class=\"faq-answer\">\n              <p>当前输入资料没有提供可核验的价格，因此本页不展示具体金额。请以实际购买页面或服务方给出的最新报价为准，并同时核对计费周期与续费规则。</p>\n            </div>\n          </article>\n\n          <article class=\"faq-row\">\n            <div class=\"faq-question\">基础版、旗舰版和团队版有什么区别？</div>\n            <div class=\"faq-answer\">\n              <p>可先按使用规模区分：基础版偏向个人基础需求，旗舰版偏向进阶使用，团队版面向多人或多设备场景。流量、线路、设备上限及服务权益需要查看实际套餐说明后再比较。</p>\n            </div>\n          </article>\n\n          <article class=\"faq-row\">\n            <div class=\"faq-question\">客户端应该从哪里下载？</div>\n            <div class=\"faq-answer\">\n              <p>本页没有收到已确认的客户端名称或官方下载地址，因此不提供安装包。应向服务方索取对应平台的下载说明，并核对发布来源，避免使用来历不明的文件。</p>\n            </div>\n          </article>\n\n          <article class=\"faq-row\">\n            <div class=\"faq-question\">收到订阅信息后应该怎么配置？</div>\n            <div class=\"faq-answer\">\n              <p>先安装与设备系统匹配的客户端，再按说明添加订阅或导入配置。导入后更新配置，选择需要的节点并启动连接；不同客户端的具体按钮名称可能不同。</p>\n            </div>\n          </article>\n\n          <article class=\"faq-row\">\n            <div class=\"faq-question\">连接不稳定时先检查什么？</div>\n            <div class=\"faq-answer\">\n              <p>先确认本机网络正常，再重新更新配置并切换其他可用节点。仍有问题时，记录客户端状态、发生时间和设备系统，再将完整信息提交给服务方排查。</p>\n            </div>\n          </article>\n\n          <article class=\"faq-row\">\n            <div class=\"faq-question\">更换手机或电脑后需要重新购买吗？</div>\n            <div class=\"faq-answer\">\n              <p>是否允许迁移、同时在线数量是否变化，应以套餐条款和实际服务说明为准。迁移前先保存必要配置，并在新设备验证可用后再清理旧设备。</p>\n            </div>\n          </article>\n\n          <article class=\"faq-row\">\n            <div class=\"faq-question\">页面提供购买入口吗？</div>\n            <div class=\"faq-answer\">\n              <p>暂不提供。由于缺少可确认的购买地址与交易信息，页面仅做信息整理和选购说明，不会生成无法验证的支付链接。</p>\n            </div>\n          </article>\n        </div>\n      </div>\n    </section>\n\n    <section class=\"closing\">\n      <div class=\"shell\">\n        <div class=\"closing-inner\">\n          <div>\n            <span class=\"section-index\">NEXT STEP</span>\n            <h2>信息确认清楚，再开始连接。</h2>\n            <p>先向服务方确认套餐价格、设备上限、客户端来源和续费方式，再按上面的步骤完成设置。慢一步核对，往往比出问题后重新排查更省时间。</p>\n          </div>\n          <a class=\"button\" href=\"#overview\">回到第一步</a>\n        </div>\n      </div>\n    </section>\n  </main>\n\n  <footer>\n    <div class=\"shell footer-inner\">\n      <div><strong>已跑路(AAEX)</strong>｜机场套餐、客户端与使用说明</div>\n      <div>本页为信息整理页面，不提供未经确认的交易或下载入口。</div>\n    </div>\n  </footer>",
